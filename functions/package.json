{
  "name": "arkad-functions",
  "private": true,
  "description": "Cloud Functions for the Arkad iOS app (Firebase project arkad-ios-app)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.1",
    "@google-cloud/storage": "^8.4.0",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "snaptrade-typescript-sdk": "^13.4.8",
    "stripe": "^23.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
